{
  "manifest_version": 3,
  "name": "ORIB",
  "version": "0.1.0",
  "description": "Bringing back old Reddit interface with new enhancements.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.reddit.com/*"],
      "css": ["classic.css"],
      "js": ["renderer.js"],
      "run_at": "document_start"
    }
  ]
}