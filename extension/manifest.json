{
  "manifest_version": 3,
  "name": "ORIB",
  "version": "0.2.0",
  "description": "Bringing back old Reddit interface with new enhancements.",
  "homepage_url": "https://github.com/rajtilakjee/orib",
  "browser_specific_settings": {
    "gecko": {
      "id": "orib@rajtilakjee.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.reddit.com/*"],
      "css": ["classic.css"],
      "js": ["renderer.js"],
      "run_at": "document_start"
    }
  ]
}